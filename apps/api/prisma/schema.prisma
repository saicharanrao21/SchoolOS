generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum StudentStatus {
  APPLICANT
  ADMITTED
  ACTIVE
  INACTIVE
  SUSPENDED
  TRANSFERRED
  WITHDRAWN
  ALUMNI
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum AdmissionStatus {
  LEAD
  ENQUIRY
  FOLLOW_UP
  APPLICATION
  DOCUMENT_COLLECTION
  VERIFICATION
  ASSESSMENT_PENDING
  INTERVIEW_PENDING
  DECISION_PENDING
  APPROVED
  WAITLISTED
  REJECTED
  OFFER_EXTENDED
  OFFER_ACCEPTED
  OFFER_DECLINED
  OFFER_EXPIRED
  WITHDRAWN
  ENROLLED
}

enum LeadSource {
  WEBSITE
  WALK_IN
  PHONE
  WHATSAPP
  REFERRAL
  ADVERTISEMENT
  SOCIAL_MEDIA
  EXISTING_PARENT
  EVENT
  OTHER
}

enum FollowUpMethod {
  CALL
  WHATSAPP
  SMS
  EMAIL
  IN_PERSON
  OTHER
}

enum FollowUpOutcome {
  INTERESTED
  NOT_INTERESTED
  CALL_BACK_LATER
  WRONG_NUMBER
  NO_RESPONSE
  CONVERTED
}

enum AdmissionDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  displayName String?
  code        String?  @unique
  slug        String   @unique
  address     String?
  phone       String?
  email       String?
  website     String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  locale      String   @default("en-US")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools     School[]
  users       User[]
  auditLogs   AuditEvent[]
}

model School {
  id             String       @id @default(uuid())
  name           String
  displayName    String?
  code           String?
  legalName      String?
  affiliation    String?
  logo           String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  phone          String?
  email          String?
  website        String?
  timezone       String       @default("UTC")
  currency       String       @default("USD")
  locale         String       @default("en-US")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campuses       Campus[]
  academicYears  AcademicYear[]
  departments    Department[]
  classes        Class[]
  subjects       Subject[]
  houses         House[]
  settings       SchoolSetting[]
  students       Student[]
  enquiries      AdmissionEnquiry[]
  applications   AdmissionApplication[]
  auditLogs      AuditEvent[]
}

model Campus {
  id        String   @id @default(uuid())
  name      String
  code      String?
  address   String?
  phone     String?
  email     String?
  capacity  Int?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations   Location[]
  enrollments Enrollment[]
  applications AdmissionApplication[]
  auditLogs   AuditEvent[]
}

model AcademicYear {
  id        String             @id @default(uuid())
  name      String             // e.g. "2026-27"
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(DRAFT)
  isCurrent Boolean            @default(false)
  schoolId  String
  school    School             @relation(fields: [schoolId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  terms          Term[]
  classes        Class[]
  calendarEvents CalendarEvent[]
  enrollments    Enrollment[]
  applications   AdmissionApplication[]

  @@unique([schoolId, name])
}

model Term {
  id             String       @id @default(uuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  sequence       Int
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, sequence])
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model Class {
  id             String       @id @default(uuid())
  name           String       // e.g. "Grade 10"
  code           String?
  sequence       Int
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sections    Section[]
  subjects    ClassSubject[]
  enrollments Enrollment[]
  applications AdmissionApplication[]

  @@unique([schoolId, name, academicYearId])
}

model Section {
  id             String   @id @default(uuid())
  name           String   // e.g. "A"
  code           String?
  capacity       Int?
  classId        String
  class          Class    @relation(fields: [classId], references: [id])
  roomId         String?
  room           Location? @relation(fields: [roomId], references: [id])
  classTeacherId String?  // Foundation for teacher assignment
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments Enrollment[]

  @@unique([classId, name])
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String
  type        String?  // e.g. "Theory", "Practical"
  category    String?  // e.g. "Core", "Elective"
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes     ClassSubject[]

  @@unique([schoolId, code])
}

model ClassSubject {
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([classId, subjectId])
}

model Location {
  id        String   @id @default(uuid())
  name      String
  code      String?
  type      String   // e.g. "Classroom", "Lab", "Office"
  capacity  Int?
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  Section[]
}

model House {
  id        String   @id @default(uuid())
  name      String
  code      String?
  color     String?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]

  @@unique([schoolId, name])
}

model CalendarEvent {
  id             String       @id @default(uuid())
  name           String
  type           String       // e.g. "Holiday", "Event", "Exam"
  startDate      DateTime
  endDate        DateTime
  isHoliday      Boolean      @default(false)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  schoolId       String?      // Optional override
  campusId       String?      // Optional override
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SchoolSetting {
  id        String   @id @default(uuid())
  category  String   // e.g. "GENERAL", "ACADEMIC"
  key       String
  value     Json
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, category, key])
}

model Student {
  id              String        @id @default(uuid())
  admissionNumber String        @unique
  firstName       String
  middleName      String?
  lastName        String
  displayName     String?
  dateOfBirth     DateTime
  gender          String?
  profilePhoto    String?
  admissionDate   DateTime      @default(now())
  status          StudentStatus @default(APPLICANT)
  nationality     String?
  bloodGroup      String?
  religion        String?
  category        String?       // e.g. General, OBC
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id])
  houseId         String?
  house           House?        @relation(fields: [houseId], references: [id])
  metadata        Json?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enrollments    Enrollment[]
  guardians      GuardianStudent[]
  documents      StudentDocument[]
  transfers      StudentTransfer[]
  withdrawals    StudentWithdrawal[]
  applications   AdmissionApplication[]
  auditLogs      AuditEvent[]
}

model Guardian {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String   @unique
  occupation  String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    GuardianStudent[]
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
}

model GuardianStudent {
  studentId        String
  guardianId       String
  relationship     RelationshipType
  isPrimary        Boolean          @default(false)
  isEmergency      Boolean          @default(false)
  hasPortalAccess  Boolean          @default(false)
  isAuthorizedPickup Boolean        @default(true)
  student          Student          @relation(fields: [studentId], references: [id])
  guardian         Guardian         @relation(fields: [guardianId], references: [id])

  @@id([studentId, guardianId])
}

model Enrollment {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  schoolId       String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  classId        String
  class          Class        @relation(fields: [classId], references: [id])
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  campusId       String
  campus         Campus       @relation(fields: [campusId], references: [id])
  rollNumber     String?
  enrollmentDate DateTime     @default(now())
  status         String       @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, studentId])
  @@unique([academicYearId, sectionId, rollNumber])
}

model StudentDocument {
  id               String   @id @default(uuid())
  name             String
  type             String   // e.g. Birth Certificate, Photo
  fileReference    String
  verificationStatus String @default("PENDING") // PENDING, VERIFIED, REJECTED
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  uploadedById     String?
  expiryDate       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StudentTransfer {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  fromSchoolId     String
  toSchoolId       String?
  fromCampusId     String
  toCampusId       String?
  transferDate     DateTime @default(now())
  reason           String?
  authorizedById   String
  notes            String?
  createdAt        DateTime @default(now())
}

model StudentWithdrawal {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  withdrawalDate   DateTime @default(now())
  reason           String?
  authorizedById   String
  notes            String?
  createdAt        DateTime @default(now())
}

model AdmissionEnquiry {
  id              String          @id @default(uuid())
  enquiryNumber   String          @unique
  firstName       String
  lastName        String
  email           String?
  phone           String
  dateOfBirth     DateTime?
  gender          String?
  interestedClassId String?
  academicYearId  String?
  campusId        String?
  source          LeadSource      @default(OTHER)
  status          AdmissionStatus @default(ENQUIRY)
  assignedToId    String?
  assignedTo      User?           @relation(fields: [assignedToId], references: [id])
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id])
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  followUps       AdmissionFollowUp[]
  applications    AdmissionApplication[]
}

model AdmissionFollowUp {
  id              String          @id @default(uuid())
  enquiryId       String
  enquiry         AdmissionEnquiry @relation(fields: [enquiryId], references: [id])
  scheduledDate   DateTime
  actualDate      DateTime?
  method          FollowUpMethod
  purpose         String?
  notes           String?
  outcome         FollowUpOutcome?
  nextFollowUpDate DateTime?
  status          String          @default("PENDING") // PENDING, COMPLETED
  staffId         String
  staff           User            @relation(fields: [staffId], references: [id])
  createdAt       DateTime        @default(now())
}

model AdmissionApplication {
  id                String          @id @default(uuid())
  applicationNumber String          @unique
  enquiryId         String?
  enquiry           AdmissionEnquiry? @relation(fields: [enquiryId], references: [id])
  firstName         String
  middleName        String?
  lastName          String
  dateOfBirth       DateTime
  gender            String
  contactEmail      String?
  contactPhone      String
  address           String?

  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id])
  academicYearId    String
  academicYear      AcademicYear    @relation(fields: [academicYearId], references: [id])
  classId           String
  class             Class           @relation(fields: [classId], references: [id])
  campusId          String
  campus            Campus          @relation(fields: [campusId], references: [id])

  status            AdmissionStatus @default(APPLICATION)
  assignedToId      String?
  assignedTo        User?           @relation(fields: [assignedToId], references: [id])

  previousSchool    String?
  previousGrade     String?

  documents         AdmissionApplicationDocument[]
  assessments       AdmissionAssessment[]
  interviews        AdmissionInterview[]
  decision          AdmissionDecision?
  offer             AdmissionOffer?

  studentId         String?         @unique // Linked when converted to student
  student           Student?        @relation(fields: [studentId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model AdmissionApplicationDocument {
  id                String                 @id @default(uuid())
  applicationId     String
  application       AdmissionApplication   @relation(fields: [applicationId], references: [id])
  name              String
  type              String
  fileReference     String
  status            AdmissionDocumentStatus @default(PENDING)
  rejectionReason   String?
  verifiedById      String?
  verifiedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model AdmissionAssessment {
  id                String               @id @default(uuid())
  applicationId     String
  application       AdmissionApplication @relation(fields: [applicationId], references: [id])
  type              String               // Entrance Test, etc.
  date              DateTime
  evaluatorId       String?
  score             String?
  result            String?              // Pass, Fail, etc.
  notes             String?
  status            String               @default("PENDING")
  createdAt         DateTime             @default(now())
}

model AdmissionInterview {
  id                String               @id @default(uuid())
  applicationId     String
  application       AdmissionApplication @relation(fields: [applicationId], references: [id])
  interviewerId     String
  date              DateTime
  location          String?
  status            InterviewStatus      @default(SCHEDULED)
  notes             String?
  outcome           String?
  createdAt         DateTime             @default(now())
}

model AdmissionDecision {
  id                String               @id @default(uuid())
  applicationId     String               @unique
  application       AdmissionApplication @relation(fields: [applicationId], references: [id])
  decision          AdmissionStatus      // APPROVED, REJECTED, WAITLISTED
  reason            String?
  decidedById       String
  date              DateTime             @default(now())
  notes             String?
}

model AdmissionOffer {
  id                String               @id @default(uuid())
  applicationId     String               @unique
  application       AdmissionApplication @relation(fields: [applicationId], references: [id])
  offeredDate       DateTime             @default(now())
  expiryDate        DateTime?
  conditions        String?
  status            String               @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED
  acceptedDate      DateTime?
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  phone          String?      @unique
  password       String
  firstName      String
  lastName       String
  displayName    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         UserStatus   @default(PENDING_VERIFICATION)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  roles          UserRole[]
  sessions       Session[]
  auditLogs      AuditEvent[]
  guardian       Guardian?

  assignedEnquiries AdmissionEnquiry[]
  followUps         AdmissionFollowUp[]
  assignedApplications AdmissionApplication[]
}

model Role {
  id             String           @id @default(uuid())
  name           String           @unique
  description    String?
  organizationId String?          // Null for global system roles
  permissions    RolePermission[]
  users          UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., "user.create"
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  isUsed    Boolean  @default(false)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditEvent {
  id             String        @id @default(uuid())
  action         String        // e.g., "login.success", "user.create"
  resource       String        // e.g., "User", "Organization"
  resourceId     String?
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id])
  campusId       String?
  campus         Campus?       @relation(fields: [campusId], references: [id])
  metadata       Json?         // Safe context data
  severity       AuditSeverity @default(LOW)
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime      @default(now())

  student        Student?      @relation(fields: [studentId], references: [id])
  studentId      String?
}
