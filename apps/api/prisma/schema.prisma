generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum StudentStatus {
  APPLICANT
  ADMITTED
  ACTIVE
  INACTIVE
  SUSPENDED
  TRANSFERRED
  WITHDRAWN
  ALUMNI
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  displayName String?
  code        String?  @unique
  slug        String   @unique
  address     String?
  phone       String?
  email       String?
  website     String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  locale      String   @default("en-US")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools     School[]
  users       User[]
  auditLogs   AuditEvent[]
}

model School {
  id             String       @id @default(uuid())
  name           String
  displayName    String?
  code           String?
  legalName      String?
  affiliation    String?
  logo           String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  phone          String?
  email          String?
  website        String?
  timezone       String       @default("UTC")
  currency       String       @default("USD")
  locale         String       @default("en-US")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campuses       Campus[]
  academicYears  AcademicYear[]
  departments    Department[]
  classes        Class[]
  subjects       Subject[]
  houses         House[]
  settings       SchoolSetting[]
  students       Student[]
  auditLogs      AuditEvent[]
}

model Campus {
  id        String   @id @default(uuid())
  name      String
  code      String?
  address   String?
  phone     String?
  email     String?
  capacity  Int?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations   Location[]
  enrollments Enrollment[]
  auditLogs   AuditEvent[]
}

model AcademicYear {
  id        String             @id @default(uuid())
  name      String             // e.g. "2026-27"
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(DRAFT)
  isCurrent Boolean            @default(false)
  schoolId  String
  school    School             @relation(fields: [schoolId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  terms          Term[]
  classes        Class[]
  calendarEvents CalendarEvent[]
  enrollments    Enrollment[]

  @@unique([schoolId, name])
}

model Term {
  id             String       @id @default(uuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  sequence       Int
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, sequence])
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model Class {
  id             String       @id @default(uuid())
  name           String       // e.g. "Grade 10"
  code           String?
  sequence       Int
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sections    Section[]
  subjects    ClassSubject[]
  enrollments Enrollment[]

  @@unique([schoolId, name, academicYearId])
}

model Section {
  id             String   @id @default(uuid())
  name           String   // e.g. "A"
  code           String?
  capacity       Int?
  classId        String
  class          Class    @relation(fields: [classId], references: [id])
  roomId         String?
  room           Location? @relation(fields: [roomId], references: [id])
  classTeacherId String?  // Foundation for teacher assignment
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments Enrollment[]

  @@unique([classId, name])
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String
  type        String?  // e.g. "Theory", "Practical"
  category    String?  // e.g. "Core", "Elective"
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes     ClassSubject[]

  @@unique([schoolId, code])
}

model ClassSubject {
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([classId, subjectId])
}

model Location {
  id        String   @id @default(uuid())
  name      String
  code      String?
  type      String   // e.g. "Classroom", "Lab", "Office"
  capacity  Int?
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  Section[]
}

model House {
  id        String   @id @default(uuid())
  name      String
  code      String?
  color     String?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]

  @@unique([schoolId, name])
}

model CalendarEvent {
  id             String       @id @default(uuid())
  name           String
  type           String       // e.g. "Holiday", "Event", "Exam"
  startDate      DateTime
  endDate        DateTime
  isHoliday      Boolean      @default(false)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  schoolId       String?      // Optional override
  campusId       String?      // Optional override
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SchoolSetting {
  id        String   @id @default(uuid())
  category  String   // e.g. "GENERAL", "ACADEMIC"
  key       String
  value     Json
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, category, key])
}

model Student {
  id              String        @id @default(uuid())
  admissionNumber String        @unique
  firstName       String
  middleName      String?
  lastName        String
  displayName     String?
  dateOfBirth     DateTime
  gender          String?
  profilePhoto    String?
  admissionDate   DateTime      @default(now())
  status          StudentStatus @default(APPLICANT)
  nationality     String?
  bloodGroup      String?
  religion        String?
  category        String?       // e.g. General, OBC
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id])
  houseId         String?
  house           House?        @relation(fields: [houseId], references: [id])
  metadata        Json?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enrollments    Enrollment[]
  guardians      GuardianStudent[]
  documents      StudentDocument[]
  transfers      StudentTransfer[]
  withdrawals    StudentWithdrawal[]
  auditLogs      AuditEvent[]
}

model Guardian {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String   @unique
  occupation  String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    GuardianStudent[]
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
}

model GuardianStudent {
  studentId        String
  guardianId       String
  relationship     RelationshipType
  isPrimary        Boolean          @default(false)
  isEmergency      Boolean          @default(false)
  hasPortalAccess  Boolean          @default(false)
  isAuthorizedPickup Boolean        @default(true)
  student          Student          @relation(fields: [studentId], references: [id])
  guardian         Guardian         @relation(fields: [guardianId], references: [id])

  @@id([studentId, guardianId])
}

model Enrollment {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  schoolId       String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  classId        String
  class          Class        @relation(fields: [classId], references: [id])
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  campusId       String
  campus         Campus       @relation(fields: [campusId], references: [id])
  rollNumber     String?
  enrollmentDate DateTime     @default(now())
  status         String       @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, studentId])
  @@unique([academicYearId, sectionId, rollNumber])
}

model StudentDocument {
  id               String   @id @default(uuid())
  name             String
  type             String   // e.g. Birth Certificate, Photo
  fileReference    String
  verificationStatus String @default("PENDING") // PENDING, VERIFIED, REJECTED
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  uploadedById     String?
  expiryDate       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StudentTransfer {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  fromSchoolId     String
  toSchoolId       String?
  fromCampusId     String
  toCampusId       String?
  transferDate     DateTime @default(now())
  reason           String?
  authorizedById   String
  notes            String?
  createdAt        DateTime @default(now())
}

model StudentWithdrawal {
  id               String   @id @default(uuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  withdrawalDate   DateTime @default(now())
  reason           String?
  authorizedById   String
  notes            String?
  createdAt        DateTime @default(now())
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  phone          String?      @unique
  password       String
  firstName      String
  lastName       String
  displayName    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  status         UserStatus   @default(PENDING_VERIFICATION)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  roles          UserRole[]
  sessions       Session[]
  auditLogs      AuditEvent[]
  guardian       Guardian?
}

model Role {
  id             String           @id @default(uuid())
  name           String           @unique
  description    String?
  organizationId String?          // Null for global system roles
  permissions    RolePermission[]
  users          UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., "user.create"
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  isUsed    Boolean  @default(false)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditEvent {
  id             String        @id @default(uuid())
  action         String        // e.g., "login.success", "user.create"
  resource       String        // e.g., "User", "Organization"
  resourceId     String?
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id])
  campusId       String?
  campus         Campus?       @relation(fields: [campusId], references: [id])
  metadata       Json?         // Safe context data
  severity       AuditSeverity @default(LOW)
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime      @default(now())

  student        Student?      @relation(fields: [studentId], references: [id])
  studentId      String?
}
